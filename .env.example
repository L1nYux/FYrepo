# 环境变量模板。复制为 .env 或写入 systemd EnvironmentFile 后按需修改。
# 真实密钥、数据库、上传文件和备份都不进入源码仓库。

# 必填：Django 密钥。安装脚本会自动随机生成，切勿提交真实值。
WORKBENCH_SECRET_KEY=replace-with-a-long-random-value

# 数据目录：数据库（workbench.sqlite3）与私有上传（private_uploads）都在这里。
WORKBENCH_DATA_DIR=/var/lib/research-workbench

# 允许访问的域名/IP，逗号分隔。
WORKBENCH_ALLOWED_HOSTS=127.0.0.1,localhost

# 生产环境必须为 0。
WORKBENCH_DEBUG=0

# 通过 HTTPS 访问时设为 1（启用安全 Cookie）。
WORKBENCH_HTTPS=0

# 前面有 HTTPS 反向代理时设为 1，用于识别 X-Forwarded-Proto。
# WORKBENCH_TRUST_PROXY=1

# 使用域名和 HTTPS 时填写，例如 https://workbench.example.com
# WORKBENCH_CSRF_ORIGINS=

# ---- 邮件：成员自助找回密码（忘记密码 → 邮箱收重置链接）----
# 不配置这些且 WORKBENCH_DEBUG=1 时，重置链接与验证码只打印在 runserver 控制台（不会真的发信）。一旦配置了下面的变量，开发环境也会真实发信。
# 生产环境不配置 SMTP 时无法发送重置邮件，成员无法自助找回，请务必填好。
#
# 可以直接用某个管理员的邮箱发信，不必专门申请新邮箱：把下面三项填成那个邮箱即可。
# WORKBENCH_EMAIL_FROM 可以留空，默认跟随 WORKBENCH_EMAIL_USER（多数邮箱服务要求两者一致）。
#
# 常见服务商：
#   QQ 邮箱      smtp.qq.com      465 / SSL（授权码在「设置 → 账户 → POP3/SMTP服务」开启）
#   腾讯企业邮    smtp.exmail.qq.com 465 / SSL
#   163 邮箱     smtp.163.com     465 / SSL
#   Gmail        smtp.gmail.com   587 / TLS（需先开两步验证，再生成「应用专用密码」）
#   阿里企业邮箱  smtp.qiye.aliyun.com 465 / SSL（需允许 SMTP 和第三方客户端访问）
WORKBENCH_EMAIL_HOST=smtp.example.com
# 465 端口用 SSL 时填 465 并把 WORKBENCH_EMAIL_SSL 设为 1；587 端口保持 TLS。
WORKBENCH_EMAIL_PORT=587
# 发信邮箱地址（可以是管理员自己的邮箱）。
WORKBENCH_EMAIL_USER=no-reply@example.com
# 按服务商和账号策略填写 SMTP 授权码/应用专用密码。
# 阿里企业邮箱未启用三方客户端安全密码时可用登录密码，启用后必须使用专用安全密码。切勿提交真实值。
WORKBENCH_EMAIL_PASSWORD=replace-with-the-smtp-password
WORKBENCH_EMAIL_TLS=1
WORKBENCH_EMAIL_SSL=0
# 发件人地址。留空则自动使用 WORKBENCH_EMAIL_USER；填了别的地址可能被服务商拒绝。
# WORKBENCH_EMAIL_FROM=no-reply@example.com
# 重置链接有效期（秒），默认 3600（1 小时）。
# WORKBENCH_RESET_TIMEOUT=3600


# Only set after the matching desktop release is published (not a release draft).
# WORKBENCH_DESKTOP_RELEASE=0.2.0

# Operational options: enable HSTS only after HTTPS is deployed.
# WORKBENCH_ADMINS=ops@example.com
# WORKBENCH_HSTS_SECONDS=31536000
# WORKBENCH_HSTS_SUBDOMAINS=0
# WORKBENCH_HSTS_PRELOAD=0
# WORKBENCH_SEARCH_URL=https://html.duckduckgo.com/html/
# auto: free Exa MCP, falling back to public search pages when unavailable.
# WORKBENCH_SEARCH_BACKEND=auto
# JavaScript reader needs python -m playwright install chromium.
# WORKBENCH_WEB_RENDER=1
# Resolve synthetic proxy DNS through TLS-verified public DNS; private addresses stay blocked.
# WORKBENCH_PROXY_DNS_FALLBACK=1
# PLAYWRIGHT_BROWSERS_PATH=/opt/research-workbench/.chromium
